{
  "manifest_version": 3,
  "name": "DMM Markdown Paste",
  "version": "1.0.0",
  "description": "DMMオンラインサロンの編集欄にMarkdownを貼り付けると、自動でリッチテキストへ変換します。",
  "content_scripts": [
    {
      "matches": ["https://owner.lounge.dmm.com/*"],
      "js": ["markdown.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "DMM Markdown Paste",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
